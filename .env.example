# Copy to .env.local and change the secret before deploying.
# Any long random string works: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Where the SQLite file and uploaded photos live. Defaults to ./data
DATA_DIR=./data

# Base URL the print renderer uses to reach this app (headless Chrome hits it over HTTP).
PRINT_BASE_URL=http://127.0.0.1:3000
