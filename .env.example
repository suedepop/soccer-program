# Copy to .env.local and change the secret before deploying.
# Any long random string works: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Keep this value STABLE across restarts and deploys. Login cookies are JWTs
# signed with it, so changing it signs every parent out. Accounts and ads are
# unaffected — they live in the database, not the cookie.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Where the SQLite file and uploaded photos live. Defaults to ./data
#
# In production use an ABSOLUTE path on storage that survives a redeploy.
# A relative path resolves against the working directory, and if the service
# starts somewhere unexpected the app creates a new empty database instead of
# finding the real one. Watch for the [db] line on startup — it prints the file
# it opened and warns loudly when it had to create one.
DATA_DIR=./data

# Base URL the print renderer uses to reach this app (headless Chrome hits it over HTTP).
PRINT_BASE_URL=http://127.0.0.1:3000
